{
  "name": "@cldmv/sizeofvar",
  "version": "1.0.9",
  "description": "Determines the initial memory usage of any javascript variable in NODE.JS",
  "main": "sizeofvar.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "echo '✓ no build step (stopgap: the CI coverage-badge job runs `npm run build`)'",
    "build:ci": "echo '✓ no build step'",
    "test": "node tests/run-vitest.mjs",
    "test:watch": "vitest --config .configs/vitest.config.mjs",
    "coverage": "node tests/run-vitest.mjs --coverage-quiet",
    "ci:coverage": "npm run coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CLDMV/sizeofvar.git"
  },
  "keywords": [
    "size",
    "variable",
    "object",
    "array",
    "string",
    "number",
    "boolean"
  ],
  "author": "Shinrai <git@cldmv.net> (http://cldmv.net)",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/CLDMV/sizeofvar/issues"
  },
  "homepage": "https://github.com/CLDMV/sizeofvar#readme",
  "devDependencies": {
    "@cldmv/vitest-runner": "^1.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "vitest": "^4.1.10"
  }
}
